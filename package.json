{
	"name": "pi-build-conductor",
	"version": "0.1.0",
	"description": "Safe multi-agent build orchestration for Pi",
	"type": "module",
	"license": "MIT",
	"author": "Max Miller",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/max-miller1204/pi-build-conductor.git"
	},
	"keywords": [
		"pi-package",
		"pi",
		"orchestration",
		"agents"
	],
	"files": [
		"src",
		"README.md",
		"SECURITY.md",
		"LICENSE"
	],
	"exports": {
		".": "./src/index.ts",
		"./extension": "./src/extension.ts"
	},
	"pi": {
		"extensions": [
			"./src/extension.ts"
		]
	},
	"scripts": {
		"check": "npm run format:check && npm run typecheck && npm test",
		"format": "biome check --write .",
		"format:check": "biome check .",
		"test": "vitest run",
		"test:crash-fixture": "vite-node test/fixtures/crash-after-task-commit.ts",
		"test:upstream": "vitest run test/orchestrator-upstream.test.ts",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "^0.80.10",
		"@earendil-works/pi-coding-agent": "^0.80.10"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@earendil-works/pi-ai": "0.80.10",
		"@earendil-works/pi-coding-agent": "0.80.10",
		"@types/node": "22.19.19",
		"@types/proper-lockfile": "^4.1.4",
		"typescript": "5.9.3",
		"vite-node": "^3.2.4",
		"vitest": "3.2.7"
	},
	"dependencies": {
		"proper-lockfile": "^4.1.2"
	},
	"overrides": {
		"@earendil-works/pi-coding-agent": {
			"brace-expansion": "5.0.7",
			"protobufjs": "7.6.5"
		}
	}
}
