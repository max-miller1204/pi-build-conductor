{
	"name": "pi-build-conductor",
	"version": "0.1.0",
	"description": "Safe multi-agent build orchestration for Pi",
	"type": "module",
	"private": true,
	"license": "MIT",
	"author": "Max Miller",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/max-miller1204/pi-build-conductor.git"
	},
	"keywords": [
		"pi-package",
		"pi",
		"orchestration",
		"agents"
	],
	"files": [
		"src",
		"README.md",
		"SECURITY.md",
		"LICENSE"
	],
	"exports": {
		".": "./src/index.ts",
		"./extension": "./src/extension.ts"
	},
	"pi": {
		"extensions": [
			"./src/extension.ts"
		]
	},
	"conductorCompatibility": {
		"testedPiVersion": "0.83.0",
		"upstreamPiTag": "v0.83.0",
		"upstreamPiCommit": "845d6ff1f6643aba440341cce877ce1c43ebbc39",
		"serverRepository": "max-miller1204/pi",
		"serverCommit": "b713633149eae9f14bac029af4938b6476d8202d",
		"workerLaunchPolicyVersion": 1
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"audit:high": "node scripts/audit-dependencies.mjs",
		"check": "npm run format:check && npm run docs:check && npm run version:check && npm run typecheck && npm test",
		"docs:check": "markdownlint-cli2 README.md SECURITY.md RELEASING.md",
		"format": "biome check --write .",
		"format:check": "biome check .",
		"github:smoke": "node scripts/smoke-package.mjs --github",
		"package:smoke": "node scripts/smoke-package.mjs",
		"pack:check": "npm pack --dry-run",
		"prepublishOnly": "npm run release:check",
		"release:check": "npm run check && npm run package:smoke && npm run audit:high",
		"test": "vitest run",
		"test:compatibility": "node scripts/run-server-compatibility.mjs",
		"test:crash-fixture": "vite-node test/fixtures/crash-after-task-commit.ts",
		"test:workflow-crash-fixture": "vite-node test/fixtures/crash-during-workflow-step.ts",
		"test:change-run-crash-fixture": "vite-node test/fixtures/crash-during-change-run.ts",
		"test:server-compat": "vitest run test/server-compatibility.test.ts",
		"test:upstream": "vitest run test/server-upstream.test.ts test/orchestrator-upstream.test.ts",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"version:check": "node scripts/check-release.mjs",
		"verify": "npm run check && npm run package:smoke"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.5",
		"@earendil-works/pi-ai": "0.83.0",
		"@earendil-works/pi-coding-agent": "0.83.0",
		"@types/node": "22.19.19",
		"@types/proper-lockfile": "^4.1.4",
		"markdownlint-cli2": "0.23.2",
		"semver": "7.8.5",
		"typescript": "5.9.3",
		"vite-node": "^3.2.4",
		"vitest": "3.2.7"
	},
	"dependencies": {
		"proper-lockfile": "^4.1.2"
	}
}
